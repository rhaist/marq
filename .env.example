# marq env-file — copy to .env and point the pi/marq shim at it:
#   MARQ_ENV_FILE=.env marq up ~/engagements/acme
# Docker --env-file format: KEY=value, one per line, no quotes, no `export`.
# (MCP clients use mcp.json.example instead — same vars, JSON form.)

# Operator — the audit attribution anchor (who is accountable). Human/env-set.
# Engagement + scope are NOT here: the model records them at session start via
# the set_engagement tool (persisted under /work), so they stay current per task.
MARQ_OPERATOR=marq

# Arbitrary-shell tool. On by default; set false to disable.
MARQ_ALLOW_RAW_SHELL=true

# Optional OSINT API keys — leave blank to use keyless sources.
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GITHUB_TOKEN=
NUMVERIFY_API_KEY=
