__pycache__/
*.pyc
.venv/
venv/

# Engagement working area — runtime mount, never committed.
/work/

# Eval harness output (traces, transcripts, per-run /work).
/scripts/eval/runs*/

# Real secrets (API keys belong in ~/.config/marq/env, never the repo).
.env

# Never commit audit logs or tool output.
*.jsonl
# …but the eval's task set IS source, not output — un-ignore it:
!scripts/eval/tasks.jsonl
*.log
/audit/

# Local research (deep-research output). The one report docs/SECURITY.md links
# stays tracked; force-add (git add -f) any other report that should ship.
/reports/
/research_notes/
