__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/

# Engagement working area — runtime mount, never committed.
/work/

# Eval harness output (traces, transcripts, per-run /work).
/scripts/eval/runs/

# Real secrets — only the .env.example template is committed.
.env

# Never commit audit logs, scan output, loot or scope files.
*.jsonl
# …but the eval's task set IS source, not output — un-ignore it:
!scripts/eval/tasks.jsonl
*.log
/audit/
/loot/
/scope.txt
/results/
