# Stock Google Gemma-4-12B-IT (QAT Q4_0) — Google's official sampling.
# /v1 drops num_ctx/top_k, so they MUST be pinned here. Build with:
#   ollama create gemma-4-12b-it-qat -f scripts/eval/ollama/Modelfile.gemma-stock
FROM hf.co/google/gemma-4-12B-it-qat-q4_0-gguf:latest
PARAMETER num_ctx 65536
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 64
