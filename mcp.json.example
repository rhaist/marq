{
  "//": "MCP server config for marq — works as-is in Claude Code (.mcp.json)",
  "//2": "and Claude Desktop. Codex uses TOML;",
  "//3": "see docs/CLIENTS.md. Paste the 'marq' entry into your mcpServers and adjust",
  "//4": "env. stdio (-i keeps it open). Engagement + scope are set at runtime by",
  "//5": "the model via the set_engagement tool, not here; operator stays env-set.",
  "//6": "marq-work persists findings/reports; swap for a bind mount (-v /host/dir:/work) to read them on the host.",
  "//caps": "no-new-privileges hardens the container but blocks the setcap SYN-scan grant: under it masscan/naabu fail and nmap -sS degrades to connect scans (nmap auto-uses -sT). If you need raw-socket SYN scans, drop the no-new-privileges line. TCP-connect scanning works either way.",
  "mcpServers": {
    "marq": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--security-opt", "no-new-privileges:true",
        "--cap-drop", "ALL",
        "--cap-add", "NET_RAW",
        "--cap-add", "NET_ADMIN",
        "--cap-add", "NET_BIND_SERVICE",
        "-v", "marq-audit:/var/log/marq",
        "-v", "marq-work:/work",
        "-e", "MARQ_OPERATOR",
        "-e", "MARQ_ALLOW_RAW_SHELL",
        "-e", "SHODAN_API_KEY",
        "-e", "CENSYS_API_ID",
        "-e", "CENSYS_API_SECRET",
        "-e", "GITHUB_TOKEN",
        "-e", "NUMVERIFY_API_KEY",
        "-e", "GOOGLE_API_KEY",
        "-e", "GOOGLECSE_CX",
        "-e", "WPSCAN_API_TOKEN",
        "marq"
      ],
      "env": {
        "MARQ_OPERATOR": "marq",
        "//shell": "run_shell (arbitrary in-container command) is OFF by default; set true to opt in.",
        "MARQ_ALLOW_RAW_SHELL": "false",
        "//keys": "Optional — enrich OSINT tools. Leave blank to use keyless sources.",
        "SHODAN_API_KEY": "",
        "CENSYS_API_ID": "",
        "CENSYS_API_SECRET": "",
        "GITHUB_TOKEN": "",
        "NUMVERIFY_API_KEY": "",
        "GOOGLE_API_KEY": "",
        "GOOGLECSE_CX": "",
        "WPSCAN_API_TOKEN": ""
      }
    }
  }
}
